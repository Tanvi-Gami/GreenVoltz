# Backend origin; the client appends versioned paths such as /api/v1/health
VITE_API_BASE_URL=http://localhost:8000

# Keep the hackathon demo independent from backend availability by default.
# Set to "false" only when the backend contract is available locally.
VITE_USE_MOCKS=true

# Optional browser-restricted Google Maps JavaScript API key.
# Without this key, the driver page shows station cards and Google Maps links.
VITE_GOOGLE_MAPS_API_KEY=
