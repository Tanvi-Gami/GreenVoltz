# GreenVoltz Environment Configuration Example

# API Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4321"]

# Database Configuration (PostgreSQL)
POSTGRES_USER=greenvoltz
POSTGRES_PASSWORD=greenvoltz_secret
POSTGRES_DB=greenvoltz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://greenvoltz:greenvoltz_secret@localhost:5432/greenvoltz_db

# Storage & Model Artifacts
ARTIFACT_STORAGE_PATH=./saved_models
FEATURES_STORAGE_PATH=./data/features
RAW_DATA_STORAGE_PATH=./data/raw
